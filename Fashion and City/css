   FASHION AND CITY - HOT PINK THEME
   ============================== */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    background-color: #fff5fa;
    color: #333;
    line-height: 1.6;
}

/* HEADINGS */

h1, h2, h3 {
    color: #ff1493;
    margin-bottom: 15px;
}

h1 {
    font-size: 36px;
    text-align: center;
}

h2 {
    font-size: 27px;
}

/* ANNOUNCEMENT BAR */

.announcement-bar {
    background-color: #ff1493;
    color: white;
    text-align: center;
    padding: 10px;
    font-weight: bold;
}

/* HEADER */

header {
    background-color: white;
    padding: 20px;
    text-align: center;
    border-bottom: 3px solid #ff69b4;
}

.logo {
    color: #ff1493;
    font-size: 30px;
    font-weight: bold;
}

/* NAVIGATION */

nav {
    background-color: #ff1493;
    padding: 15px;
    text-align: center;
}

nav a {
    color: white;
    text-decoration: none;
    margin: 0 15px;
    font-weight: bold;
}

nav a:hover {
    color: #ffe4f1;
    text-decoration: underline;
}

/* MAIN CONTENT */

main {
    width: 90%;
    max-width: 1200px;
    margin: 30px auto;
}

section {
    margin-bottom: 35px;
}

/* IMAGES */

img {
    max-width: 100%;
    height: auto;
}

.category-grid,
.product-grid,
.featured-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
    margin-top: 20px;
}

.category-card,
.product-card,
.featured-card {
    background-color: white;
    border: 1px solid #ffc0e0;
    border-radius: 12px;
    padding: 15px;
    text-align: center;
    box-shadow: 0 3px 10px rgba(255, 20, 147, 0.10);
}

.category-card img,
.product-card img,
.featured-card img {
    width: 100%;
    height: 230px;
    object-fit: cover;
    border-radius: 8px;
}

.category-card h3,
.product-card h3 {
    margin-top: 12px;
}

/* BUTTONS */

button,
.button,
input[type="submit"] {
    background-color: #ff1493;
    color: white;
    border: none;
    padding: 12px 20px;
    border-radius: 6px;
    cursor: pointer;
    font-weight: bold;
    margin-top: 10px;
}

button:hover,
.button:hover,
input[type="submit"]:hover {
    background-color: #d90075;
}

/* LINKS */

a {
    color: #e60083;
}

a:hover {
    color: #ff69b4;
}

/* FORMS */

form {
    background-color: white;
    padding: 25px;
    border: 1px solid #ffc0e0;
    border-radius: 12px;
    max-width: 700px;
    margin: 20px auto;
}

label {
    display: block;
    margin: 12px 0 5px;
    font-weight: bold;
}

input,
select,
textarea {
    width: 100%;
    padding: 12px;
    border: 1px solid #ff9dcc;
    border-radius: 6px;
    font-size: 15px;
    margin-bottom: 10px;
}

input:focus,
select:focus,
textarea:focus {
    outline: 2px solid #ff1493;
    border-color: #ff1493;
}

textarea {
    min-height: 120px;
    resize: vertical;
}

/* SEARCH BAR */

.search-container {
    text-align: center;
    margin: 20px 0;
}

.search-container input {
    max-width: 450px;
}

/* PRODUCT PRICES */

.price {
    color: #ff1493;
    font-size: 19px;
    font-weight: bold;
}

/* LIGHTBOX */

.lightbox {
    display: none;
    position: fixed;
    z-index: 1000;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.85);
    justify-content: center;
    align-items: center;
    padding: 20px;
}

.lightbox img {
    max-width: 90%;
    max-height: 85vh;
    object-fit: contain;
}

.lightbox.active {
    display: flex;
}

.lightbox .close {
    position: absolute;
    top: 20px;
    right: 30px;
    color: white;
    font-size: 35px;
    cursor: pointer;
}

/* Fashion and City Logo */

.site-logo {
    width: 150px;
    height: auto;
    display: block;
    margin: 0 auto 10px;
    object-fit: contain;
}


/* VIDEO */

iframe {
    max-width: 100%;
    border-radius: 10px;
}

/* FOOTER */

footer {
    background-color: #ff1493;
    color: white;
    text-align: center;
    padding: 25px;
    margin-top: 40px;
}

footer a {
    color: white;
    text-decoration: none;
}

footer a:hover {
    text-decoration: underline;
}

/* MOBILE RESPONSIVENESS */

@media screen and (max-width: 768px) {
    h1 {
        font-size: 28px;
    }

    nav a {
        display: inline-block;
        margin: 7px;
    }

    main {
        width: 95%;
    }

    .category-grid,
    .product-grid,
    .featured-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
    }

    .category-card img,
    .product-card img,
    .featured-card img {
        height: 180px;
    }
}

@media screen and (max-width: 420px) {
    .category-grid,
    .product-grid,
    .featured-grid {
        grid-template-columns: 1fr;
    }
}

/* =================================
   SHEIN-INSPIRED SHOP CATEGORIES
================================= */

.shop-categories {
    width: 100%;
    margin: 45px auto;
    padding: 20px 0;
}

.category-heading {
    text-align: center;
    margin-bottom: 25px;
}

.category-heading h2 {
    color: #ff1493;
    font-size: 28px;
    font-weight: bold;
}

.category-heading p {
    color: #555;
    font-size: 15px;
}

.category-container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
}

.category-item {
    position: relative;
    display: block;
    height: 340px;
    overflow: hidden;
    border-radius: 5px;
    text-decoration: none;
    background: #f8dce9;
}

.category-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
}

.category-item:hover img {
    transform: scale(1.07);
}

.category-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 25px 10px;
    text-align: center;
    color: white;
    background: linear-gradient(
        transparent,
        rgba(0, 0, 0, 0.75)
    );
}

.category-overlay h3 {
    color: white;
    font-size: 25px;
    margin-bottom: 8px;
}

.category-overlay span {
    display: inline-block;
    background: #ff1493;
    color: white;
    padding: 9px 22px;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 1px;
}

/* TABLET */

@media screen and (max-width: 768px) {
    .category-container {
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }

    .category-item {
        height: 280px;
    }

    .category-overlay h3 {
        font-size: 20px;
    }
}

/* MOBILE */

@media screen and (max-width: 480px) {
    .category-container {
        grid-template-columns: repeat(2, 1fr);
        gap: 9px;
    }

    .category-item {
        height: 220px;
    }

    .category-overlay {
        padding: 15px 5px;
    }

    .category-overlay h3 {
        font-size: 16px;
    }

    .category-overlay span {
        padding: 7px 12px;
        font-size: 10px;
    }
}

/* FASHION AND CITY VIDEO SECTION */

.fashion-videos {
    padding: 50px 5%;
    margin: 30px auto;
    background: #fff0f7;
}

.video-heading {
    text-align: center;
    margin-bottom: 30px;
}

.video-heading > p {
    color: #ff1493;
    font-weight: bold;
    letter-spacing: 4px;
    font-size: 13px;
}

.video-heading h2 {
    color: #ff1493;
    font-size: 32px;
    margin: 8px 0;
}

.video-heading span {
    color: #555;
}

.video-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
    max-width: 1200px;
    margin: auto;
}

.video-card {
    background: white;
    padding: 12px;
    border-radius: 12px;
    box-shadow: 0 4px 15px rgba(255, 20, 147, 0.12);
    transition: transform 0.3s ease;
}

.video-card:hover {
    transform: translateY(-5px);
}

.video-frame {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 8px;
    background: #f8dce9;
}

.video-frame iframe {
    width: 100%;
    height: 100%;
    border: none;
}

.video-card h3 {
    color: #ff1493;
    margin: 15px 5px 5px;
    font-size: 17px;
}

.video-card p {
    color: #666;
    margin: 0 5px 10px;
    font-size: 13px;
}

/* TABLETS */

@media (max-width: 768px) {
    .video-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

/* MOBILE */

@media (max-width: 480px) {
    .video-grid {
        grid-template-columns: 1fr;
    }

    .video-heading h2 {
        font-size: 25px;
    }
}

/* OFF-PAGE SEO SOCIAL MEDIA */

.social-media {
    text-align: center;
    padding: 35px 15px;
    background-color: #fff0f7;
}

.social-media h2 {
    color: #ff1493;
}

.social-media a {
    display: inline-block;
    background-color: #ff1493;
    color: white;
    text-decoration: none;
    padding: 12px 25px;
    margin: 8px;
    border-radius: 5px;
    font-weight: bold;
}

.social-media a:hover {
    background-color: #d90075;
}







    
    

