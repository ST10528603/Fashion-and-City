body {
    margin:10px;
    padding:10px;
    font-family: Arial, Helvetica, sans-serif;
    background-color: hotpink;
    color: black ;
    font-size: 16px;
}   

h1{font-family: 'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif;
    text-align: center;
    font-size: 30px;
    font-weight: bold;
    color: white  ;
    text-decoration: underline;
    text-transform: uppercase;
    border: 5px black;
    padding: 10px;
    border-radius: 30px;
    background-color: lightblue ;


h2{font-family:Arial, Helvetica, sans-serif;
        text-align: center;
        font-size: 30px;
        font-weight: bold;
        color: cornsilk;
        text-decoration: underline;
        text-transform: uppercase;
        border: 5px white;
        padding: 10px;
        border-radius: 30px;
        background-color: black;
}

h3{font-family: fantasy;
   text-align: center;
   font-size: 30px;
   font-weight: bold;
   color: lightblue;
   text-decoration: darkmagenta;
   text-transform: uppercase;
   border: 5px white;
   padding: 10px;
   border-radius: 30px;
   background-color:black;
}
nav a:column-width {
    font-family: Arial, Helvetica, sans-serif;
    text-decoration: double;
    padding: 10px;
    color: floralwhite;
}
nav a:hover{
           font-size: 30px;
           color: aliceblue;
}
nav a:visited{
    text-decoration:double;
    color: aliceblue;
}

}

.muted{color: aqua;}

@media (min-width: 600px) {
    /*Navigation */
    .navbar{
        flex-direction: column;
        padding: 15px;
    }
    /*Fashion and City logo */
    .logo {
        font-size: 18px;
    }
    /* Navigation links */
    .nav-links {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 12px;
    }
    .nav-links a{
        font-size: 13px;
    }
    /*Search bar */
    .search {
        width: 100%;
        justify-content: center;
    }
    .search input {
        width: 70%;
    }
    /* Home page */
    .hero {
        min-height: 500px;
    }
    .hero content {
        width: 90%;
        margin: auto;
        text-align: center;
    }
    .hero h1 {
        font-size: 42px;
    }
    .hero p {
        font-size: 15px;
    }
    /* Buttons */
    .hero button {
        padding: 12px 20px;
    }
    /* Introduction */
    .intro {
        padding: 40px 20px;
    }
    .intro h2 {
         font-size: 28px;
    }

}
@media (max-width: 900px) {
    
    .navbar {
        flex-wrap: wrap;
        justify-content: center;
    }
    .nav-links {
        justify-content: center;
        flex-wrap: wrap;
    }
    .hero content {
        width: 80%;
        margin: auto;
        text-align: center;
    }
    .hero h1 {
        font-size: 55px;
    }
}
    
